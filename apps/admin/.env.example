# Copy to .env.local. Never commit the real file — .gitignore already excludes it.
#
# Point at the deployed functions for the project you are operating. `default`
# in .firebaserc is dev (joevideotube); production is kidgate.
VITE_FUNCTIONS_URL=https://asia-southeast1-joevideotube.cloudfunctions.net

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
