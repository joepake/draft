# Copy to `.env.dev` or `.env.prod`. This file is the only one committed.
#
# Vite reads `.env.<mode>`; the `dev` / `prod` names work because every script
# passes `--mode`. Keep that in sync if you add a script.
#
#   run:dev    vite --mode dev          .env.dev
#   run:prod   vite --mode prod         .env.prod
#   build:prod vite build --mode prod   .env.prod
#   build:dev  vite build --mode dev    .env.dev

# Absolute URL of apps/dashboard. Falls back to https://dashboard.kidgate.app.
# dev: http://localhost:5173
VITE_DASHBOARD_URL=

# Nothing else belongs here. No VITE_FIREBASE_* — if a change to this app needs
# a signed-in user, it belongs in apps/dashboard.

# Google Analytics 4 — three counters and nothing else: visits, macOS download
# clicks, Windows download clicks. See src/lib/analytics.js.
#
# The `G-...` of this site's **own** web data stream. It is not the dashboard's
# and not the desktop agent's: a marketing visitor and a running agent are not
# the same population, and one stream would make every per-user number
# meaningless.
#
# Blank is supported and is what a fresh checkout runs as — gtag is never
# loaded and nothing is sent.
VITE_GA_MEASUREMENT_ID=

# `false` stops measurement without a code change. This is a public,
# unauthenticated page with no consent banner in the repo; apps/site/CLAUDE.md
# records that decision and what would reverse it.
VITE_ANALYTICS_ENABLED=
