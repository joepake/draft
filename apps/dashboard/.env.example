# Copy to `.env.dev` (joevideotube) or `.env.prod` (kidgate) and fill in.
# This file is the only one of the three that is committed.
#
# Vite reads `.env.<mode>`, and its default modes are `development` /
# `production` — the `dev` and `prod` names work because every script passes
# `--mode`. Keep that in sync if you add a script.
#
#   run:dev    vite --mode dev          .env.dev
#   run:prod   vite --mode prod         .env.prod
#   build:prod vite build --mode prod   .env.prod
#   build:dev  vite build --mode dev    .env.dev
#
# All of these end up inlined in a public bundle. They identify the project;
# they do not grant access. `firestore.rules` is the control. Do not add a
# secret here expecting it to stay one.

# Firebase **Web** app registration (Console → Project settings → Your apps →
# Web). An Android or iOS app id will not work.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Project identity. dev: joevideotube / 679132409416 / joevideotube.appspot.com
#                  prod: kidgate / 847735427015 / kidgate.firebasestorage.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloud Functions base URL, no trailing slash.
# https://asia-southeast1-<projectId>.cloudfunctions.net
# Region comes from functions/index.js:11 (FUNCTIONS_REGION overrides it).
VITE_FIREBASE_FUNCTIONS_URL=

# Absolute URL of apps/site. Falls back to https://kidgate.app when unset.
VITE_SITE_URL=

# Google Analytics 4, through the Firebase web SDK (`src/lib/analytics.js`).
#
# The `G-...` of the **KidGate Dashboard** data stream — this app's own, not the
# desktop agent's. A parent opens this for two minutes where a child's agent
# runs all day, so sharing one stream would make every per-user number
# meaningless.
#
# It must belong to the GA property linked to VITE_FIREBASE_PROJECT_ID above.
# Getting that wrong points production traffic at the dev property, and nothing
# reports it.
#
# Blank is supported: `getAnalytics` is never called and the app runs unmeasured.
VITE_FIREBASE_MEASUREMENT_ID=

# Set to `false` to run with analytics off — the switch for an environment that
# must not measure until the cookie-consent decision is made. See
# docs/SETUP_GOLIVE.md.
VITE_ANALYTICS_ENABLED=
