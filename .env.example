# Firebase web config — Firebase Console → Project settings → Your apps → Web.
# These values are public by design (they identify the project, they do not
# grant access); Firestore rules and App Check are what actually protect data.
# Set them in Vercel → Project → Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions base URL, no trailing slash. Example:
# https://us-central1-<project-id>.cloudfunctions.net
# Used for updateDeviceControls / setDeviceLock / resolveTimeRequest.
VITE_FIREBASE_FUNCTIONS_URL=
