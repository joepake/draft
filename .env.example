# Firebase web config.
#
# These values are public by design — they identify the project, they do not
# grant access. Firestore rules are what actually protect the data. They are
# still environment variables rather than literals so production and preview
# can point at different projects.
#
# Values below are pre-filled for the PRODUCTION project (`kidgate`), taken
# from the app's own google-services.json / GoogleService-Info.prod.plist.
# The two blanks can only come from a Web app registration:
#   Firebase Console → Project settings → Your apps → Add app → Web
#
# The web app must live in the SAME project the mobile app writes to, or the
# dashboard will sign in successfully and then find no family.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_PROJECT_ID=kidgate
VITE_FIREBASE_AUTH_DOMAIN=kidgate.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=kidgate.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=847735427015

# Cloud Functions base URL, no trailing slash.
# functions/index.js sets region asia-southeast1 (FUNCTIONS_REGION overrides
# it) — confirm against the URL shown in the Firebase Functions console.
VITE_FIREBASE_FUNCTIONS_URL=https://asia-southeast1-kidgate.cloudfunctions.net

# ---------------------------------------------------------------------------
# Dev project (`joevideotube`) — use these for Vercel Preview deployments so a
# preview build never reads or writes a real family's data.
#
# VITE_FIREBASE_PROJECT_ID=joevideotube
# VITE_FIREBASE_AUTH_DOMAIN=joevideotube.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=joevideotube.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=679132409416
# VITE_FIREBASE_FUNCTIONS_URL=https://asia-southeast1-joevideotube.cloudfunctions.net
